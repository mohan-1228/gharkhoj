{
  "name": "gharkhoj",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "storage:setup": "tsx --conditions=react-server scripts/storage-setup.ts",
    "setup": "pnpm install && docker compose up -d && pnpm db:migrate && pnpm storage:setup && pnpm db:seed",
    "prepare": "husky",
    "cdk": "pnpm --dir infra cdk"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-rekognition": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hookform/resolvers": "^7.0.6",
    "@prisma/client": "^6.16.0",
    "@tanstack/react-query": "^5.0.0",
    "aws-jwt-verify": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.5.0",
    "jose": "^5.9.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.460.0",
    "next": "15.5.29",
    "next-intl": "^4.0.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.0",
    "nuqs": "^2.4.0",
    "pino": "^9.0.0",
    "radix-ui": "^1.8.1",
    "react": "19.1.10",
    "react-day-picker": "^9.4.0",
    "react-dom": "19.1.10",
    "react-hook-form": "^7.54.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.0",
    "yet-another-react-lightbox": "^3.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/aws-lambda": "^8.10.0",
    "@types/leaflet": "^1.9.0",
    "@types/leaflet.markercluster": "^1.5.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "husky": "^9.1.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.2.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^6.16.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "sharp": "^0.35.5",
      "deepmerge-ts@<8": "^8.0.0",
      "zod": "$zod"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed/index.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "description": "GharKhoj — rental marketplace for Nepal"
}
