# ─────────────────────────────────────────────────────────────────────────────
# GharKhoj environment variables. Copy to `.env.local` for local development:
#   cp .env.example .env.local
# NEVER commit real secrets. Production values live in AWS Secrets Manager / SSM.
# ─────────────────────────────────────────────────────────────────────────────

APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database (docker compose exposes PostGIS on 5433 to avoid clashing with a local Postgres)
DATABASE_URL=postgresql://gharkhoj:gharkhoj@localhost:5433/gharkhoj?schema=public
TEST_DATABASE_URL=postgresql://gharkhoj:gharkhoj@localhost:5433/gharkhoj_test?schema=public

# Auth: "dev" = pick a seeded demo user at /login (local only); "cognito" = Amazon Cognito Hosted UI
AUTH_MODE=dev
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=

# Storage (MinIO locally; real S3 on AWS — leave S3_ENDPOINT and keys empty there)
AWS_REGION=ap-south-1
S3_BUCKET=gharkhoj-media
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Where processed images are served from (CloudFront domain on AWS)
MEDIA_BASE_URL=http://localhost:9000/gharkhoj-media
# inline = process images in the web process (dev); lambda = S3 event → image-processor Lambda
IMAGE_PROCESSING=inline
# off | rekognition
MODERATION=off

# Email: smtp (Mailpit locally, UI at http://localhost:8025) | ses | log
MAIL_TRANSPORT=smtp
MAIL_FROM="GharKhoj <no-reply@gharkhoj.local>"
SMTP_HOST=localhost
SMTP_PORT=1025

# Geocoding (OpenStreetMap Nominatim — requests are proxied + cached server side)
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT="GharKhoj/1.0 (self-hosted rental marketplace)"

# Shared secret for Lambda → internal API calls. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=change-me-internal-secret-at-least-32-characters

# Public (exposed to the browser)
NEXT_PUBLIC_APP_NAME=GharKhoj
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
