# Enforce Conventional Commits (feat:, fix:, chore:, docs:, refactor:, test:, ci:, perf:, build:)
if ! head -1 "$1" | grep -qE '^(feat|fix|chore|docs|refactor|test|ci|perf|build|style|revert)(\([a-z0-9-]+\))?!?: .{3,}'; then
  echo "✖ Commit message must follow Conventional Commits, e.g. 'feat(listings): add photo reorder'" >&2
  exit 1
fi
